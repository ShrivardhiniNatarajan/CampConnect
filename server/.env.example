PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=campconnect

JWT_SECRET=campconnect_jwt_secret_key

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================================================
# REAL SMS GATEWAY SETTINGS (Choose EITHER Option 1 OR Option 2)
# If left empty, CampConnect runs in Development Mode (code on screen).
# ==============================================================

# Option 1: Fast2SMS (Recommended for India - quick 2-min setup)
# 1. Sign up at https://www.fast2sms.com (₹50 free testing credit)
# 2. Go to Dev API -> copy your API Key below:
FAST2SMS_API_KEY=

# Option 2: Twilio (Global / International SMS)
# 1. Sign up at https://www.twilio.com (free trial credit)
# 2. Get Account SID, Auth Token, and a Twilio phone number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=